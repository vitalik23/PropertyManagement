@using PropertyManagement.Models.UnitViewModels
@model UnitDeleteViewModel

<form data-modal-form data-refresh-url="/Units/List?propertyId=@Model.PropertyId" data-refresh-target="#units-list" asp-controller="Units" asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PropertyId" />
    <input type="hidden" asp-for="UnitNumber" />
    <div class="modal-header">
        <h5 class="modal-title">Remove Unit</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <p>Are you sure you want to remove unit <strong>@Model.UnitNumber</strong>? It will be hidden from your active lists.</p>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Remove</button>
    </div>
</form>
