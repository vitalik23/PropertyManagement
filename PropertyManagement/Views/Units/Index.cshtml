@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Units";
    var propertyId = ViewData["PropertyId"];
    var propertyName = ViewData["PropertyName"];
}

<p><a asp-controller="Properties" asp-action="Index">&larr; Back to Properties</a></p>
<h1 class="mb-3">Units — @propertyName</h1>

<div id="units-list">
    @await Component.InvokeAsync("UnitsList", new { propertyId })
</div>
