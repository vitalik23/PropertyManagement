@using PropertyManagement.Models.UnitTypeViewModels
@model UnitTypeFormViewModel

<form data-modal-form data-refresh-url="/UnitTypes/List" data-refresh-target="#unit-types-list" asp-controller="UnitTypes" asp-action="@(Model.Id.HasValue ? "Edit" : "Create")" method="post">
    <div class="modal-header">
        <h5 class="modal-title">@(Model.Id.HasValue ? "Edit Unit Type" : "Add Unit Type")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        @if (Model.Id.HasValue)
        {
            <input type="hidden" asp-for="Id" />
        }
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-check">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
