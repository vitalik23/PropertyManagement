@using PropertyManagement.Domain.Entities
@model List<UnitType>

<div class="data-table-card">
    <div class="data-table-header">
        <h1 class="data-table-title">Unit Types <span class="data-table-count">Total @Model.Count</span></h1>
        <div class="data-table-actions">
            <a href="#" class="btn btn-table-primary" data-modal-url="/UnitTypes/Create">Add Unit Type</a>
        </div>
    </div>
    <div class="data-table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted">No unit types yet.</td>
                    </tr>
                }
                @foreach (var unitType in Model)
                {
                    <tr>
                        <td>@unitType.Name</td>
                        <td>
                            @if (unitType.IsActive)
                            {
                                <span class="status-badge status-badge-success">Active</span>
                            }
                            else
                            {
                                <span class="status-badge status-badge-muted">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="#" class="btn btn-sm btn-table-secondary" data-modal-url="/UnitTypes/Edit/@unitType.Id">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
