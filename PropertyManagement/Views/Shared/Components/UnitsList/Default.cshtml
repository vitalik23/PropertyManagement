@using PropertyManagement.Domain.Entities
@model List<Unit>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Unit #</th>
            <th>Bedrooms</th>
            <th>Monthly rent</th>
            <th>Unit type</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="5" class="text-center text-muted">No units yet.</td>
            </tr>
        }
        @foreach (var unit in Model)
        {
            <tr>
                <td>@unit.UnitNumber</td>
                <td>@unit.Bedrooms</td>
                <td>@unit.MonthlyRent.ToString("C")</td>
                <td>
                    @unit.UnitType.Name
                    @if (!unit.UnitType.IsActive)
                    {
                        <span class="badge text-bg-secondary">Inactive</span>
                    }
                </td>
                <td class="text-end">
                    <a href="#" class="btn btn-sm btn-outline-secondary" data-modal-url="/Units/Edit/@unit.Id">Edit</a>
                    <a href="#" class="btn btn-sm btn-outline-danger" data-modal-url="/Units/Delete/@unit.Id">Remove</a>
                </td>
            </tr>
        }
    </tbody>
</table>
