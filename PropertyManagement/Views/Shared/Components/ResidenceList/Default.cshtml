@using PropertyManagement.ViewComponents
@model ResidenceListViewComponentModel

<table class="table table-striped">
    <thead>
        <tr>
            <th>Address</th>
            <th>Landlord</th>
            <th>Landlord phone</th>
            <th>Move-in</th>
            <th>Move-out</th>
            @if (Model.IsEditable)
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model.Residences.Count == 0)
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No prior residences added yet.</td>
            </tr>
        }
        @foreach (var residence in Model.Residences)
        {
            <tr>
                <td>@residence.Address</td>
                <td>@residence.LandlordName</td>
                <td>@residence.LandlordPhone</td>
                <td>@residence.MoveInDate.ToString("d")</td>
                <td>@residence.MoveOutDate.ToString("d")</td>
                @if (Model.IsEditable)
                {
                    <td class="text-end">
                        <a href="#" class="btn btn-sm btn-outline-secondary" data-modal-url="/Applications/EditResidence/@residence.Id">Edit</a>
                        <a href="#" class="btn btn-sm btn-outline-danger" data-modal-url="/Applications/DeleteResidence/@residence.Id">Remove</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@if (Model.IsEditable)
{
    <a href="#" class="btn btn-primary" data-modal-url="/Applications/AddResidence?applicationId=@Model.ApplicationId">Add Residence</a>
}
