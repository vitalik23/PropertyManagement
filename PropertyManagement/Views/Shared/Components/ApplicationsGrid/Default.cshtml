@using PropertyManagement.ViewComponents
@model ApplicationsGridViewModel

<div class="data-table-card" id="applications-grid"
     data-api-url="/api/applications"
     data-detail-url-template="@Model.DetailUrlTemplate"
     data-is-pm="@Model.IsPropertyManager.ToString().ToLowerInvariant()"
     data-can-withdraw="@Model.CanWithdraw.ToString().ToLowerInvariant()">

    <div class="data-table-header">
        <h1 class="data-table-title">@Model.Title <span class="data-table-count" id="applications-grid-count"></span></h1>
        <div class="data-table-actions">
            <select class="data-table-select" data-grid-filter="status">
                <option value="">All statuses</option>
                @foreach (var value in Model.Statuses)
                {
                    <option value="@value">@value</option>
                }
            </select>
            <select class="data-table-select" data-grid-filter="propertyId">
                <option value="">All properties</option>
                @foreach (var property in Model.Properties)
                {
                    <option value="@property.Id">@property.Name</option>
                }
            </select>
        </div>
    </div>

    <div class="data-table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th role="button" data-grid-sort="property">Property</th>
                    <th role="button" data-grid-sort="unit">Unit #</th>
                    @if (Model.IsPropertyManager)
                    {
                        <th>Applicant</th>
                    }
                    <th role="button" data-grid-sort="status">Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="applications-grid-body">
                <tr>
                    <td colspan="5" class="text-center text-muted">Loading&hellip;</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="data-table-footer">
        <span id="applications-grid-summary" class="text-muted"></span>
        <div>
            <button type="button" class="btn btn-sm btn-table-secondary" data-grid-page="prev">Prev</button>
            <button type="button" class="btn btn-sm btn-table-secondary" data-grid-page="next">Next</button>
        </div>
    </div>
</div>
