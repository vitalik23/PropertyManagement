@using PropertyManagement.Domain.Constants
@{
    Layout = "_Layout";
}
<div class="d-flex portal-layout">
    <nav class="portal-sidebar">
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-controller="Portal" asp-action="Profile">Profile</a>
            </li>
            @if (User.IsInRole(Roles.PropertyManager))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Properties" asp-action="Index">Properties</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="UnitTypes" asp-action="Index">Unit Types</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Review" asp-action="Index">Applications</a>
                </li>
            }
            @if (User.IsInRole(Roles.Applicant))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Browse" asp-action="Index">Browse Units</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Applications" asp-action="Index">My Applications</a>
                </li>
            }
            <li class="nav-item">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="nav-link btn btn-link">Logout</button>
                </form>
            </li>
        </ul>
    </nav>
    <div class="portal-content flex-grow-1">
        @RenderBody()
    </div>
</div>
