@using PropertyManagement.Infrastructure.Services
@using PropertyManagement.Models.ReviewViewModels
@model ReviewViewModel

<form data-modal-form data-refresh-url="/Review/DetailsPartial/@Model.ApplicationId" data-refresh-target="#application-details" asp-controller="Review" asp-action="Review" method="post">
    <div class="modal-header">
        <h5 class="modal-title">Review Application</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" asp-for="ApplicationId" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label d-block">Outcome</label>
            @foreach (var outcome in Enum.GetValues<ReviewOutcome>())
            {
                <div class="form-check form-check-inline">
                    <input type="radio" asp-for="Outcome" value="@outcome" class="form-check-input" id="outcome-@outcome" />
                    <label class="form-check-label" for="outcome-@outcome">@outcome</label>
                </div>
            }
            <span asp-validation-for="Outcome" class="text-danger d-block"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Comment" class="form-label"></label>
            <textarea asp-for="Comment" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Comment" class="text-danger"></span>
            <div class="form-text">Required for Return or Deny.</div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
