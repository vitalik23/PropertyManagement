@using PropertyManagement.ViewModels.Application
@model RentalApplicationWizardViewModel

<h4>Summary</h4>

<h5>Applicant Information</h5>
<dl class="row">
    <dt class="col-sm-3">Full name</dt>
    <dd class="col-sm-9">@Model.FullName</dd>
    <dt class="col-sm-3">Phone number</dt>
    <dd class="col-sm-9">@Model.PhoneNumber</dd>
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Current address</dt>
    <dd class="col-sm-9">@Model.CurrentAddress</dd>
</dl>

<h5>Residence History</h5>
@await Component.InvokeAsync("ResidenceList", new { applicationId = Model.Id, isEditable = false })

@if (Model.IsEditable && Model.BlockingIssues.Count > 0)
{
    <div class="alert alert-warning">
        <p class="mb-1">Please resolve the following before submitting:</p>
        <ul class="mb-0">
            @foreach (var issue in Model.BlockingIssues)
            {
                <li>@issue.Section @(string.IsNullOrEmpty(issue.Field) ? "" : $"— {issue.Field}"): @issue.Message</li>
            }
        </ul>
    </div>
}
