@using PropertyManagement.ViewModels.Application
@model RentalApplicationWizardViewModel
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Rental Application";
}

<h1>Rental Application</h1>
<p class="text-muted">@Model.UnitDisplay</p>

<div id="co-applicants-list">
    @await Html.PartialAsync("_CoApplicantsListPartial", Model)
</div>

<form asp-controller="Applications" asp-action="Wizard" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CurrentSection" />
    <input type="hidden" asp-for="ApplicantInfoVersion" />
    <input type="hidden" asp-for="ResidenceHistoryVersion" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @if (!ViewData.ModelState.IsValid)
    {
        <a asp-action="Wizard" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary mb-3">Reload</a>
    }

    @if (Model.CurrentSection == WizardSection.ApplicantInfo)
    {
        @await Html.PartialAsync("Sections/_ApplicantInfoSection", Model)
    }
    else if (Model.CurrentSection == WizardSection.ResidenceHistory)
    {
        @await Html.PartialAsync("Sections/_ResidenceHistorySection", Model)
    }
    else
    {
        @await Html.PartialAsync("Sections/_SummarySection", Model)
    }

    <div class="mt-3 wizard-actions">
        @* Continue/Submit render before Back in the DOM on purpose: with more than one submit button in a form,
           implicit submission (Enter key, some mobile "Go" actions) activates the first one in DOM order. Back
           is still shown on the left visually via the .btn-back CSS order rule. *@
        @if (Model.IsEditable && Model.CurrentSection != WizardSection.Summary)
        {
            <button type="submit" name="submitAction" value="continue" class="btn btn-primary">Continue</button>
        }
        @if (Model.IsEditable && Model.CurrentSection == WizardSection.Summary && Model.ApplicantInfoSaved && Model.ResidenceHistorySaved)
        {
            <button type="submit" name="submitAction" value="submit" class="btn btn-success">Submit</button>
        }
        @if (Model.IsEditable && Model.CurrentSection != WizardSection.ApplicantInfo)
        {
            <button type="submit" name="submitAction" value="back" class="btn btn-secondary btn-back" formnovalidate>Back</button>
        }
    </div>
</form>
