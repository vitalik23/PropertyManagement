@using PropertyManagement.Models.ApplicationViewModels
@model ResidenceDeleteViewModel

<form data-modal-form data-refresh-url="/Applications/ResidenceList?applicationId=@Model.ApplicationId" data-refresh-target="#residence-list" asp-controller="Applications" asp-action="DeleteResidence" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ApplicationId" />
    <input type="hidden" asp-for="Address" />
    <div class="modal-header">
        <h5 class="modal-title">Remove Residence</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <p>Are you sure you want to remove <strong>@Model.Address</strong>?</p>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Remove</button>
    </div>
</form>
