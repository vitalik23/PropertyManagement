@using PropertyManagement.Models.ApplicationViewModels
@model WithdrawConfirmViewModel

<form data-modal-form asp-controller="Applications" asp-action="Withdraw" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="modal-header">
        <h5 class="modal-title">Withdraw Application</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <p>Are you sure you want to withdraw your application for <strong>@Model.UnitDisplay</strong>? This cannot be undone.</p>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Withdraw</button>
    </div>
</form>
