@using PropertyManagement.ViewModels.Application
@model RentalApplicationWizardViewModel

<p class="small">
    <strong>Co-Applicants:</strong>
    @if (Model.CoApplicantEmails.Count == 0)
    {
        <span class="text-muted">None</span>
    }
    else
    {
        <span>@string.Join(", ", Model.CoApplicantEmails)</span>
    }
    @if (Model.IsEditable)
    {
        <a href="#" class="btn btn-sm btn-outline-secondary ms-2" data-modal-url="/Applications/InviteCoApplicant?applicationId=@Model.Id">Invite</a>
    }
</p>
